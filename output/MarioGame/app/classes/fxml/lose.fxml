<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="1000" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalproject.LoseController">
   <ImageView fitHeight="600.0" fitWidth="994.0" layoutY="-1.0" pickOnBounds="true">
      <image>
         <Image url="@../image/loseview.png" />
      </image>
   </ImageView>
   <Button fx:id="btnPlayAgain" layoutX="313.0" layoutY="240.0" mnemonicParsing="false" onAction="#playAgain" prefHeight="133.0" prefWidth="159.0" style="-fx-background-color: transparent;; -fx-border-color: transparent;;">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor>
   </Button>
   <Button fx:id="btnbackMenu" layoutX="564.0" layoutY="241.0" mnemonicParsing="false" onAction="#backMenu" prefHeight="133.0" prefWidth="168.0" style="-fx-background-color: transparent;; -fx-border-color: transparent;;">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor>
   </Button>

</AnchorPane>
