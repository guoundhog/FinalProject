<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalproject.WinController">
   <ImageView fitHeight="600.0" fitWidth="1000.0" layoutX="-14.0" pickOnBounds="true" AnchorPane.topAnchor="0.0">
      <image>
         <Image url="@../image/playagainorbacktomenu.png" />
      </image>
   </ImageView>
   <Button fx:id="btnPlayAgain" layoutX="301.0" layoutY="247.0" mnemonicParsing="false" onAction="#playAgain" prefHeight="134.0" prefWidth="162.0" style="-fx-background-color: transparent;; -fx-border-color: transparent;" AnchorPane.topAnchor="247.0">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor>
   </Button>
   <Button fx:id="btnbackMenu" layoutX="554.0" layoutY="246.0" mnemonicParsing="false" onAction="#backMenu" prefHeight="134.0" prefWidth="162.0" style="-fx-background-color: transparent;; -fx-border-color: transparent;">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor>
   </Button>

</AnchorPane>
