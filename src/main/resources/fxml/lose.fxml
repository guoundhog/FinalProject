<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600" prefWidth="1000"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.finalproject.LoseController">

    <Label layoutX="440" layoutY="170" text="YOU LOSE"
           style="-fx-font-size: 40px; -fx-text-fill: red;"/>

    <Button layoutX="400" layoutY="280" prefWidth="200"
            text="Play Again" onAction="#playAgain"/>

    <Button layoutX="400" layoutY="350" prefWidth="200"
            text="Back To Menu" onAction="#backMenu"/>

</AnchorPane>